############## ITEM DEFAULTS ###############
sketchybar --default label.padding_left=6 \
      label.padding_right=6 \
      icon.padding_left=6 \
      icon.padding_right=6 \
      icon.font="SF Pro Rounded:Regular:17" \
      label.font="SF Pro Rounded:Bold:14.0" \
      background.height=32 \
      background.padding_right=4 \
      background.padding_left=4 \
      background.corner_radius=6

sketchybar --add item clock_icon left \
      --set clock_icon icon=󰥔 \
      icon.padding_right=8\
      icon.padding_left=6\
      icon.color=0xff121219 \
      label.drawing=off \
      padding_left=3 \
      background.color=0xff92B3F5

sketchybar --add item hour left \
      --set hour update_freq=20 \
      icon.drawing=off \
      script="~/.config/sketchybar/plugins/hour.sh"\
      background.color=0x003C3E4F \
      background.padding_left=0

sketchybar --add item min left \
      --set min update_freq=20 \
      icon.drawing=off \
      script="~/.config/sketchybar/plugins/min.sh" \
      background.color=0x003C3E4F \
      background.padding_left=-6

sketchybar --add item date_icon left \
      --set date_icon icon=󰃭 \
      icon.padding_right=8\
      icon.padding_left=6\
      icon.color=0xff121219 \
      padding_right=8 \
      padding_left=8 \
      label.drawing=off \
      background.color=0xffff9e64
sketchybar \
      --add item date left --set date update_freq=120 icon.drawing=off padding_right=5 label="$(date '+%d' | sed s/^0//)" \
      --add item month left --set month update_freq=120 icon.drawing=off padding_right=5 label="$(date '+%b')" \
      --add item day left --set day update_freq=120 icon.drawing=off padding_right=5 label="$(date '+%a')"

############## RIGHT ITEMS ##############

